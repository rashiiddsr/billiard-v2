DATABASE_URL="mysql://billiard:password@localhost:3306/billiard_pos"

# JWT
JWT_SECRET="ganti-dengan-secret-panjang-min-32-karakter"
JWT_REFRESH_SECRET="ganti-dengan-refresh-secret-berbeda-min-32"
JWT_ACCESS_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV=development

# CORS — pisahkan dengan koma jika multiple origin
CORS_ORIGIN="http://localhost:3000"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=300
