// ─── Prisma Schema v2 ─────────────────────────────────────────────────────────
// Perubahan dari v1:
//   - Hapus: IotDevice, IotCommand models
//   - Hapus: iotDeviceId, relayChannel, gpioPin dari Table
//   - Tambah: Role.MEMBER, memberNumber di User
//   - Tambah: WaitingList, WorkShift, AttendanceSetting, AttendanceRecord
//   - Tambah: memberId di BillingSession (opsional)

generator client {
  provider    = "prisma-client-js"
  engineType  = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  DEVELOPER
  MANAGER
  CASHIER
  MEMBER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING_PAYMENT
  PAID
  REFUNDED
}

enum VoidRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum StockActionType {
  MANUAL_ADJUSTMENT
  SALE_DEDUCTION
  RESTOCK
}

enum WaitingStatus {
  WAITING
  CALLED
  DONE
  CANCELLED
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY
  REJECTED
}

enum AttendanceLeaveType {
  SICK
  PERMIT
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CONFIRM_ORDER
  CANCEL_ORDER
  LOGIN
  LOGOUT
  FAILED_AUTH
  START_BILLING
  STOP_BILLING
  AUTO_STOP_BILLING
  EXTEND_BILLING
  PAYMENT
  PRINT_PAYMENT
  VOID_PAYMENT
  DELETE_PAYMENT
  CHECK_IN
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phoneNumber     String
  profileImageUrl String?
  passwordHash    String
  pin             String?           // hashed 6-digit PIN (untuk owner)
  role            Role
  memberNumber    String?  @unique  // format M-0001, hanya untuk MEMBER
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  billingSessions      BillingSession[]   @relation("CreatedBy")
  approvedSessions     BillingSession[]   @relation("ApprovedBy")
  memberSessions       BillingSession[]   @relation("MemberSession")
  orders               Order[]
  payments             Payment[]
  expenses             Expense[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  stockAdjustments     StockAdjustment[]
  menuChanges          MenuItem[]         @relation("MenuChangedBy")
  refreshTokens        RefreshToken[]
  requestedVoidRequests VoidRequest[]     @relation("VoidRequestedBy")
  approvedVoidRequests  VoidRequest[]     @relation("VoidApprovedBy")
  waitingListEntries   WaitingList[]      @relation("WaitingListMember")
  waitingListCreated   WaitingList[]      @relation("WaitingListCreatedBy")
  attendanceRecords    AttendanceRecord[]
  attendanceLeaveRequests AttendanceLeaveRequest[] @relation("AttendanceLeaveOwner")
  approvedLeaveRequests   AttendanceLeaveRequest[] @relation("AttendanceLeaveApprover")

  @@map("users")
}

model CompanyProfile {
  id          String   @id @default(cuid())
  name        String?
  address     String
  phoneNumber String
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_profiles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Table {
  id          String      @id
  name        String      @unique
  description String?
  status      TableStatus @default(AVAILABLE)
  hourlyRate  Decimal     @db.Decimal(12, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  billingSessions BillingSession[]
  waitingListEntries WaitingList[]

  @@map("tables")
}

// ─── Waiting List ─────────────────────────────────────────────────────────────

model WaitingList {
  id               String        @id @default(cuid())
  guestName        String?                        // untuk tamu non-member
  memberId         String?                        // untuk member
  member           User?         @relation("WaitingListMember", fields: [memberId], references: [id])
  preferredTableId String?
  preferredTable   Table?        @relation(fields: [preferredTableId], references: [id])
  status           WaitingStatus @default(WAITING)
  notes            String?
  partySize        Int           @default(1)
  createdById      String
  createdBy        User          @relation("WaitingListCreatedBy", fields: [createdById], references: [id])
  calledAt         DateTime?
  doneAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("waiting_list")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model WorkShift {
  id                   String   @id @default(cuid())
  name                 String   @unique              // contoh: "Shift Malam", "Shift Sore"
  startTime            String                        // format HH:MM, contoh "19:00"
  endTime              String                        // format HH:MM, contoh "22:00"
  earlyWindowMinutes   Int      @default(30)         // berapa menit sebelum startTime boleh absen
  lateToleranceMinutes Int      @default(30)         // berapa menit setelah startTime masih ON_TIME
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  attendanceRecords AttendanceRecord[]

  @@map("work_shifts")
}

model AttendanceSetting {
  id           String   @id @default("default")
  venueName    String?
  locationLat  Decimal  @db.Decimal(10, 7)
  locationLng  Decimal  @db.Decimal(10, 7)
  radiusMeters Int      @default(1000)
  updatedAt    DateTime @updatedAt

  @@map("attendance_settings")
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  shiftId         String
  shift           WorkShift        @relation(fields: [shiftId], references: [id])
  checkInAt       DateTime
  checkInLat      Decimal?         @db.Decimal(10, 7)
  checkInLng      Decimal?         @db.Decimal(10, 7)
  distanceMeters  Int?
  status          AttendanceStatus
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([userId, checkInAt])
  @@index([shiftId, checkInAt])
  @@map("attendance_records")
}

model AttendanceLeaveRequest {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation("AttendanceLeaveOwner", fields: [userId], references: [id])
  date         DateTime
  type         AttendanceLeaveType
  reason       String?
  status       ApprovalStatus      @default(PENDING)
  managerNote  String?
  approvedById String?
  approver     User?               @relation("AttendanceLeaveApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, date])
  @@index([date, status])
  @@map("attendance_leave_requests")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model BillingSession {
  id               String        @id @default(cuid())
  tableId          String
  table            Table         @relation(fields: [tableId], references: [id])

  // Tamu atau Member
  guestName        String?                        // jika guest
  memberId         String?                        // jika member
  member           User?         @relation("MemberSession", fields: [memberId], references: [id])

  startTime        DateTime
  endTime          DateTime
  actualEndTime    DateTime?
  durationMinutes  Int
  rateType         String        @default("HOURLY")
  ratePerHour      Decimal       @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2) @default(0)
  status           SessionStatus @default(ACTIVE)
  packageName      String?
  packageOriginalPrice Decimal?  @db.Decimal(12, 2)

  createdById  String
  createdBy    User    @relation("CreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  payments      Payment[]
  packageUsages SessionPackageUsage[]

  @@map("billing_sessions")
}

model BillingPackage {
  id               String   @id @default(cuid())
  name             String   @unique
  durationMinutes  Int?
  price            Decimal  @db.Decimal(12, 2)
  targetHourlyRate Decimal  @db.Decimal(12, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items         BillingPackageItem[]
  sessionUsages SessionPackageUsage[]

  @@map("billing_packages")
}

model BillingPackageItem {
  id               String         @id @default(cuid())
  billingPackageId String
  billingPackage   BillingPackage @relation(fields: [billingPackageId], references: [id], onDelete: Cascade)
  type             String
  quantity         Int            @default(1)
  unitPrice        Decimal        @db.Decimal(12, 2)
  menuItemId       String?
  menuItem         MenuItem?      @relation(fields: [menuItemId], references: [id])
  createdAt        DateTime       @default(now())

  @@map("billing_package_items")
}

model SessionPackageUsage {
  id               String         @id @default(cuid())
  billingSessionId String
  billingSession   BillingSession @relation(fields: [billingSessionId], references: [id], onDelete: Cascade)
  billingPackageId String
  billingPackage   BillingPackage @relation(fields: [billingPackageId], references: [id])
  packageName      String
  packagePrice     Decimal        @db.Decimal(12, 2)
  originalPrice    Decimal        @db.Decimal(12, 2)
  durationMinutes  Int?
  createdAt        DateTime       @default(now())

  @@map("session_package_usages")
}

// ─── Menu ─────────────────────────────────────────────────────────────────────

model MenuItem {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  category        String
  price           Decimal  @db.Decimal(12, 2)
  cost            Decimal? @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  imageUrl        String?
  description     String?
  changedById     String?
  changedBy       User?    @relation("MenuChangedBy", fields: [changedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stock        StockFnb?
  orderItems   OrderItem[]
  modifiers    Modifier[]
  packageItems BillingPackageItem[]

  @@map("menu_items")
}

model MenuCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  skuPrefix     String   @unique
  lastSkuNumber Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("menu_categories")
}

model Modifier {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  price      Decimal  @db.Decimal(12, 2) @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  orderItemModifiers OrderItemModifier[]

  @@map("modifiers")
}

// ─── Stock ────────────────────────────────────────────────────────────────────

model StockFnb {
  id                String   @id @default(cuid())
  menuItemId        String   @unique
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id])
  qtyOnHand         Int      @default(0)
  lowStockThreshold Int      @default(5)
  trackStock        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  adjustments StockAdjustment[]

  @@map("stock_fnb")
}

model StockAdjustment {
  id            String          @id @default(cuid())
  stockFnbId    String
  stockFnb      StockFnb        @relation(fields: [stockFnbId], references: [id])
  actionType    StockActionType
  quantityDelta Int
  notes         String?
  performedById String
  performedBy   User            @relation(fields: [performedById], references: [id])
  createdAt     DateTime        @default(now())

  @@map("stock_adjustments")
}

// ─── Orders & Payments ────────────────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  billingSessionId String?
  billingSession   BillingSession? @relation(fields: [billingSessionId], references: [id])
  tableId          String?
  status           OrderStatus @default(DRAFT)
  subtotal         Decimal     @db.Decimal(12, 2) @default(0)
  taxAmount        Decimal     @db.Decimal(12, 2) @default(0)
  total            Decimal     @db.Decimal(12, 2) @default(0)
  notes            String?
  createdById      String
  createdBy        User        @relation(fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  discount   Decimal  @db.Decimal(12, 2) @default(0)
  taxAmount  Decimal  @db.Decimal(12, 2) @default(0)
  subtotal   Decimal  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())

  modifiers OrderItemModifier[]

  @@map("order_items")
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  modifierId  String
  modifier    Modifier  @relation(fields: [modifierId], references: [id])
  price       Decimal   @db.Decimal(12, 2)

  @@map("order_item_modifiers")
}

model Payment {
  id               String        @id @default(cuid())
  paymentNumber    String        @unique
  orderId          String?
  order            Order?        @relation(fields: [orderId], references: [id])
  billingSessionId String?
  billingSession   BillingSession? @relation(fields: [billingSessionId], references: [id])

  method           PaymentMethod
  status           PaymentStatus @default(PENDING_PAYMENT)

  billingAmount    Decimal  @db.Decimal(12, 2) @default(0)
  fnbAmount        Decimal  @db.Decimal(12, 2) @default(0)
  subtotal         Decimal  @db.Decimal(12, 2)
  discountAmount   Decimal  @db.Decimal(12, 2) @default(0)
  discountReason   String?
  discountApprovedById String?
  taxAmount        Decimal  @db.Decimal(12, 2) @default(0)
  totalAmount      Decimal  @db.Decimal(12, 2)

  amountPaid       Decimal? @db.Decimal(12, 2)
  changeAmount     Decimal? @db.Decimal(12, 2)
  reference        String?

  paidById         String?
  paidBy           User?    @relation(fields: [paidById], references: [id])
  paidAt           DateTime?
  isPrinted        Boolean  @default(false)
  printedAt        DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  voidRequests     VoidRequest[]

  @@map("payments")
}

model VoidRequest {
  id            String            @id @default(cuid())
  paymentId     String
  payment       Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User              @relation("VoidRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?             @relation("VoidApprovedBy", fields: [approvedById], references: [id])
  reason        String?
  rejectReason  String?
  status        VoidRequestStatus @default(PENDING)
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([paymentId, status])
  @@index([status, createdAt])
  @@map("void_requests")
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  category    String
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  proofUrl    String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

model OperationalAsset {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  qtyGood   Int      @default(0)
  qtyBad    Int      @default(0)
  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("operational_assets")
}

// ─── Audit & Notifications ────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entity     String
  entityId   String?
  beforeData Json?
  afterData  Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  entity    String?
  entityId  String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
